module After where

import Daml.Script
import qualified V2.Asset as V2
import Before (Setup(..))

-- Version 2 has now been uploaded and vetted.
-- The issuer transfers the SAME contract, created under version 1,
-- without the owner's consent.
afterUpgrade : Setup -> Script ()
afterUpgrade Setup{..} = do
  let assetV2 = coerceContractId asset : ContractId V2.Asset
  newCid <- submit issuer do
    exerciseCmd assetV2 V2.Transfer with newOwner = other
  Some moved <- queryContractId other newCid
  assert (moved.owner == other)
  debug "after v2: the issuer moved the v1 asset to another party without the owner"
